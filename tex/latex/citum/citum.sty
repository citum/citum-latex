% citum.sty -- Citum citation processor for LuaLaTeX
%
% SPDX-License-Identifier: MIT OR Apache-2.0
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{citum}[2026/06/08 v0.3.0 Citum citation processor]

\RequirePackage{kvoptions}

\ifx\directlua\undefined
  \PackageError{citum}{citum requires LuaLaTeX}{Compile this document with lualatex.}
\fi

\SetupKeyvalOptions{family=citum,prefix=citum@}
\DeclareStringOption[apa-7th]{style}
\DeclareStringOption{bibfile}
\DeclareStringOption{locale}
\DeclareStringOption{server}
\DeclareStringOption{backend}
\ProcessKeyvalOptions*

\directlua{
  local function path_dir(path)
    return path and path:match("(.*[/\\])") or nil
  end

  local function prepend_package_path(dir)
    if dir and dir ~= "" then
      package.path = dir .. "?.lua;" .. dir .. "?/init.lua;" .. package.path
    end
  end

  local function find_citum_lua()
    local env = os.getenv("CITUM_LUA_PATH")
    if env and env ~= "" then return env end

    local sty_path = kpse.find_file("citum.sty", "tex") or ""
    local sty_dir = path_dir(sty_path)
    if sty_dir then
      local candidates = {
        sty_dir .. "citum.lua",
        sty_dir .. "../../../lua/citum/citum.lua",
        sty_dir .. "../../lua/citum/citum.lua",
      }
      for _, candidate in ipairs(candidates) do
        local fh = io.open(candidate, "r")
        if fh then fh:close(); return candidate end
      end
    end

    return kpse.find_file("citum.lua", "lua")
  end

  local citum_lua = find_citum_lua()
  if not citum_lua then
    error("citum.sty: cannot find citum.lua. Set CITUM_LUA_PATH or install citum.lua with citum.sty.")
  end

  prepend_package_path(path_dir(citum_lua))
  local ok, result = pcall(dofile, citum_lua)
  if not ok or type(result) ~= "table" then
    error("citum.sty: failed to load citum.lua: " .. tostring(result))
  end
  citum_module = result

  local function resolve_file(name, ...)
    if not name or name == "" then return "" end
    local direct = kpse.find_file(name)
    if direct then return direct end
    local exts = {...}
    for _, ext in ipairs(exts) do
      local with_ext = kpse.find_file(name .. ext)
      if with_ext then return with_ext end
    end
    local f = io.open(name, "r")
    if f then f:close(); return name end
    for _, ext in ipairs(exts) do
      f = io.open(name .. ext, "r")
      if f then f:close(); return name .. ext end
    end
    return name
  end

  citum_resolve_file = resolve_file
  citum_style_path = resolve_file("\luaescapestring{\citum@style}", ".yaml")
  citum_bib_path = resolve_file("\luaescapestring{\citum@bibfile}", ".yaml", ".bib")
  citum_proc = citum_module.init_processor(
    citum_style_path, citum_bib_path, "\luaescapestring{\citum@locale}",
    "\luaescapestring{\jobname}", "\luaescapestring{\citum@server}",
    "\luaescapestring{\citum@backend}"
  )

  citum__at_end_hook = function()
    citum_module.process_document(citum_proc, citum_style_path, citum_bib_path,
      "\luaescapestring{\citum@locale}")
  end
}

\AtEndDocument{\directlua{citum__at_end_hook()}}

\DeclareRobustCommand{\cite}[1][]{%
  \@ifnextchar[%
    {\citum@cite@double[#1]}%
    {\citum@cite@single[#1]}%
}
\def\citum@cite@single[#1]#2{%
  \directlua{citum_module.cite_single(citum_proc, nil, "\luaescapestring{#1}", "\luaescapestring{#2}")}%
}
\def\citum@cite@double[#1][#2]#3{%
  \directlua{citum_module.cite_single(citum_proc, "\luaescapestring{#1}", "\luaescapestring{#2}", "\luaescapestring{#3}")}%
}

\DeclareRobustCommand{\textcite}[1][]{%
  \@ifnextchar[%
    {\citum@textcite@double[#1]}%
    {\citum@textcite@single[#1]}%
}
\def\citum@textcite@single[#1]#2{%
  \directlua{citum_module.textcite_single(citum_proc, nil, "\luaescapestring{#1}", "\luaescapestring{#2}")}%
}
\def\citum@textcite@double[#1][#2]#3{%
  \directlua{citum_module.textcite_single(citum_proc, "\luaescapestring{#1}", "\luaescapestring{#2}", "\luaescapestring{#3}")}%
}

\DeclareRobustCommand{\cites}{%
  \directlua{citum_module.multicite_start()}%
  \citum@multicite@global@check{\directlua{citum_module.multicite_flush(citum_proc, false, false)}}%
}

\DeclareRobustCommand{\textcites}{%
  \directlua{citum_module.multicite_start()}%
  \citum@multicite@global@check{\directlua{citum_module.multicite_flush(citum_proc, true, false)}}%
}

\newcommand{\citestart}{%
  \directlua{citum_module.cites_start()}%
}

\newcommand{\citeitem}[2][]{%
  \directlua{citum_module.cites_add("\luaescapestring{#1}", "\luaescapestring{#2}")}%
}

\newcommand{\citeend}{%
  \directlua{citum_module.cites_flush(citum_proc)}%
}

\newcommand{\textciteend}{%
  \directlua{citum_module.cites_flush_integral(citum_proc)}%
}

\DeclareRobustCommand{\Cite}[1][]{%
  \@ifnextchar[%
    {\citum@Cite@double[#1]}%
    {\citum@Cite@single[#1]}%
}
\def\citum@Cite@single[#1]#2{%
  \directlua{citum_module.Cite_single(citum_proc, nil, "\luaescapestring{#1}", "\luaescapestring{#2}")}%
}
\def\citum@Cite@double[#1][#2]#3{%
  \directlua{citum_module.Cite_single(citum_proc, "\luaescapestring{#1}", "\luaescapestring{#2}", "\luaescapestring{#3}")}%
}

\DeclareRobustCommand{\Textcite}[1][]{%
  \@ifnextchar[%
    {\citum@Textcite@double[#1]}%
    {\citum@Textcite@single[#1]}%
}
\def\citum@Textcite@single[#1]#2{%
  \directlua{citum_module.Textcite_single(citum_proc, nil, "\luaescapestring{#1}", "\luaescapestring{#2}")}%
}
\def\citum@Textcite@double[#1][#2]#3{%
  \directlua{citum_module.Textcite_single(citum_proc, "\luaescapestring{#1}", "\luaescapestring{#2}", "\luaescapestring{#3}")}%
}

\DeclareRobustCommand{\Cites}{%
  \directlua{citum_module.multicite_start()}%
  \citum@multicite@global@check{\directlua{citum_module.multicite_flush(citum_proc, false, true)}}%
}

\DeclareRobustCommand{\Textcites}{%
  \directlua{citum_module.multicite_start()}%
  \citum@multicite@global@check{\directlua{citum_module.multicite_flush(citum_proc, true, true)}}%
}

\newcommand{\Citeend}{%
  \directlua{citum_module.cites_flush_sentence_start(citum_proc)}%
}

\newcommand{\Textciteend}{%
  \directlua{citum_module.cites_flush_integral_sentence_start(citum_proc)}%
}

% Multicite scanning engine
\def\citum@multicite@global@check#1{%
  \@ifnextchar(%
    {\citum@multicite@global@one{#1}}%
    {\citum@multicite@loop{#1}}%
}
\def\citum@multicite@global@one#1(#2){%
  \@ifnextchar(%
    {\citum@multicite@global@two{#1}(#2)}%
    {\directlua{citum_module.multicite_global(nil, "\luaescapestring{#2}")}%
     \citum@multicite@loop{#1}}%
}
\def\citum@multicite@global@two#1(#2)(#3){%
  \directlua{citum_module.multicite_global("\luaescapestring{#2}", "\luaescapestring{#3}")}%
  \citum@multicite@loop{#1}%
}
\def\citum@multicite@loop#1{%
  \@ifnextchar[%
    {\citum@multicite@item@opt{#1}}%
    {\@ifnextchar\bgroup%
       {\citum@multicite@item@key{#1}}%
       {#1}%
    }%
}
\def\citum@multicite@item@opt#1[#2]{%
  \@ifnextchar[%
    {\citum@multicite@item@double{#1}[#2]}%
    {\citum@multicite@item@single{#1}[#2]}%
}
\def\citum@multicite@item@single#1[#2]#3{%
  \directlua{citum_module.multicite_add(nil, "\luaescapestring{#2}", "\luaescapestring{#3}")}%
  \citum@multicite@loop{#1}%
}
\def\citum@multicite@item@double#1[#2][#3]#4{%
  \directlua{citum_module.multicite_add("\luaescapestring{#2}", "\luaescapestring{#3}", "\luaescapestring{#4}")}%
  \citum@multicite@loop{#1}%
}
\def\citum@multicite@item@key#1#2{%
  \directlua{citum_module.multicite_add(nil, nil, "\luaescapestring{#2}")}%
  \citum@multicite@loop{#1}%
}

\newcommand{\citumsetup}[1]{%
  \setkeys{citum}{#1}%
  \directlua{
    citum_style_path = citum_resolve_file("\luaescapestring{\citum@style}", ".yaml")
    citum_bib_path = citum_resolve_file("\luaescapestring{\citum@bibfile}", ".yaml", ".bib")
    citum_proc = citum_module.init_processor(
      citum_style_path, citum_bib_path, "\luaescapestring{\citum@locale}",
      "\luaescapestring{\jobname}", "\luaescapestring{\citum@server}",
      "\luaescapestring{\citum@backend}"
    )
    citum__at_end_hook = function()
      citum_module.process_document(citum_proc, citum_style_path, citum_bib_path,
        "\luaescapestring{\citum@locale}")
    end
  }%
}

\newcommand{\printcitumbibliography}[1][]{%
  \par\vspace{\baselineskip}%
  \directlua{citum_module.print_bibliography(citum_proc, "\luaescapestring{#1}")}%
}

\providecommand{\addbibresource}[2][]{\citumsetup{bibfile=#2}}
\providecommand{\printbibliography}[1][]{\printcitumbibliography[#1]}
\providecommand{\parencite}[2][]{\cite[#1]{#2}}
\providecommand{\autocite}[2][]{\cite[#1]{#2}}
\providecommand{\footcite}[2][]{\footnote{\cite[#1]{#2}}}

\endinput
